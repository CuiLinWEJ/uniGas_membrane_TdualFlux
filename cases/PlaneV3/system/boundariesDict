FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      boundariesDict;
}

uniGasPatchBoundaries
(
    boundary
    {
        patchBoundaryProperties
        {
            patch       farField;
        }
        boundaryModel       uniGasDeletionPatch;
        uniGasDeletionPatchProperties
        {
            allSpecies      yes;
        }
    }
);

uniGasCyclicBoundaries
(
    boundary
    {
        cyclicBoundaryProperties
        {
            patch       plate_front;
        }
        boundaryModel       uniGasReflectiveParticleMembranePatch;
        uniGasReflectiveParticleMembranePatchProperties
        {
            // Bird §14.6 solid front face:
            // diffuse reflection with wall temperature equal to stagnation
            // temperature reported in the book.
            reflectionProbability  0.5;
            velocity        (0 0 0);
            temperature     200;
            forceWriteInterval          1e-3;
        }
    }

    boundary
    {
        cyclicBoundaryProperties
        {
            patch       plate_back;
        }
        boundaryModel       uniGasReflectiveParticleMembranePatch;
        uniGasReflectiveParticleMembranePatchProperties
        {
            // Bird §14.6 rear face: static freestream temperature.
            reflectionProbability  0.5;
            velocity        (0 0 0);
            temperature     200;
            forceWriteInterval          1e-3;
        }
    }
);

uniGasGeneralBoundaries
(
    boundary
    {
        generalBoundaryProperties
        {
            patch                   farField;
        }
        boundaryModel                   uniGasFreeStreamInflowPatch;
        uniGasFreeStreamInflowPatchProperties
        {
            typeIds                     (Ar);
            velocity                    (1317.3 0 0);
            translationalTemperature    200;
            rotationalTemperature       200;
            vibrationalTemperature      200;
            electronicTemperature       0;
            numberDensities
            {
                Ar                      1e20;
            };
        }
    }
);

