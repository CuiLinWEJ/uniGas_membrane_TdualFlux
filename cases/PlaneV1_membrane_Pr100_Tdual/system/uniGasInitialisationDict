FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      uniGasInitialisationDict;
}

configurations
(
    configuration
    {
        type                        uniGasMeshFill;

        numberDensities
        {
            Ar                      1e20;
        };

        translationalTemperature    200;
        rotationalTemperature       200;
        vibrationalTemperature      200;
        electronicTemperature       0;

        velocity                    (1317.3 0 0);
    }
);

