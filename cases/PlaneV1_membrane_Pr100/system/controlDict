FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     uniGasFoam;

startFrom       startTime;

nTerminalOutputs    100;

startTime       0;

stopAt          endTime;

endTime         0.04;

deltaT          1e-6;

writeControl    runTime;

writeInterval   0.001;

purgeWrite      2;

writeFormat     ascii;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  no;

functions
{
}

