    (12  8   -0.01)  // 23

    ( 0 -8    0.01)  // 24
    (12 -8    0.01)  // 25
    ( 0 -0.5  0.01)  // 26
    (12 -0.5  0.01)  // 27
    ( 0  0.5  0.01)  // 28
    (12  0.5  0.01)  // 29
    ( 0  8    0.01)  // 30
    (12  8    0.01)  // 31
);

blocks
(
    hex (0 1 3 2 8 9 11 10)       (160 240 1) simpleGrading (0.25 0.25 1)
    hex (2 3 5 4 10 11 13 12)     (160 100 1) simpleGrading (0.25 1    1)
    hex (4 5 7 6 12 13 15 14)     (160 240 1) simpleGrading (0.25 4    1)

    hex (16 17 19 18 24 25 27 26) (360 240 1) simpleGrading (4    0.25 1)
    hex (18 19 21 20 26 27 29 28) (360 100 1) simpleGrading (4    1    1)
    hex (20 21 23 22 28 29 31 30) (360 240 1) simpleGrading (4    4    1)
);

edges
(
);

boundary
(
    farField
    {
        type patch;
        faces
        (
            // upstream external boundary
            (0 8 10 2)
            (2 10 12 4)
            (4 12 14 6)

            // downstream external boundary
            (17 19 27 25)
            (19 21 29 27)
            (21 23 31 29)

            // bottom external boundary
            (0 1 9 8)
            (16 17 25 24)

            // top external boundary
            (6 14 15 7)
            (22 30 31 23)
        );
    }

    plate_front
    {
        // Upstream/front side of the zero-thickness membrane.
        type cyclic;
        neighbourPatch plate_back;
        faces
        (
            (3 5 13 11)
        );
    }

    plate_back
    {
        // Downstream/rear side of the zero-thickness membrane.
        type cyclic;
        neighbourPatch plate_front;
        faces
        (
            (18 26 28 20)
        );
    }

    x0_gap_lower_left
    {
        type patch;
        faces
        (
            (1 3 11 9)
