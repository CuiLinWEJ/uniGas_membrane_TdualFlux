            (5 7 15 13)
        );
    }

    x0_gap_upper_right
    {
        type patch;
        faces
        (
            (20 28 30 22)
        );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            // z-min
            (0 2 3 1)
            (2 4 5 3)
            (4 6 7 5)
            (16 18 19 17)
            (18 20 21 19)
            (20 22 23 21)

            // z-max
            (8 9 11 10)
            (10 11 13 12)
            (12 13 15 14)
            (24 25 27 26)
            (26 27 29 28)
            (28 29 31 30)
        );
    }
);

