FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Bird §14.6:
// Argon, T_inf = 200 K, n_inf = 1e20 m^-3, U_inf = 1317.3 m/s.
// Flat plate semi-height = 0.15 m, so full height H = 0.30 m.
// lambda_inf ~= 0.01294 m, Kn_inf = lambda_inf/H ~= 0.043.
//
// Coordinates below are nondimensional by H before scaling.
// Domain: x/H = -4..12, y/H = -8..8.
// Plate: x = 0, y/H = -0.5..0.5.

convertToMeters 0.30;

vertices
(
    // Left/upstream fluid region; x = -4..0
    (-4 -8   -0.01)  // 0
    ( 0 -8   -0.01)  // 1
    (-4 -0.5 -0.01)  // 2
    ( 0 -0.5 -0.01)  // 3
    (-4  0.5 -0.01)  // 4
    ( 0  0.5 -0.01)  // 5
    (-4  8   -0.01)  // 6
    ( 0  8   -0.01)  // 7

    (-4 -8    0.01)  // 8
    ( 0 -8    0.01)  // 9
    (-4 -0.5  0.01)  // 10
    ( 0 -0.5  0.01)  // 11
    (-4  0.5  0.01)  // 12
    ( 0  0.5  0.01)  // 13
    (-4  8    0.01)  // 14
    ( 0  8    0.01)  // 15

    // Right/downstream fluid region; duplicated x = 0 vertices make the plate.
    ( 0 -8   -0.01)  // 16
    (12 -8   -0.01)  // 17
    ( 0 -0.5 -0.01)  // 18
    (12 -0.5 -0.01)  // 19
    ( 0  0.5 -0.01)  // 20
    (12  0.5 -0.01)  // 21
