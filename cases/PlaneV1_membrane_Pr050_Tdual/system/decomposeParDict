FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          decomposeParDict;
}

numberOfSubdomains 14;

method          scotch;

simpleCoeffs
{
    n               ( 4 3 2 );
    delta           0.001;
}

hierarchicalCoeffs
{
    n               ( 1 1 1 );
    delta           0.001;
    order           xyz;
}

manualCoeffs
{
    dataFile        ;
}

distributed     no;

roots           ( );


